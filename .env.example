# Postgres (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:pass@host:5432/tokens"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# X developer portal → your app → User authentication settings → OAuth 2.0
# Callback URL: https://<your-domain>/api/auth/callback/twitter
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# 32 random bytes, base64 — encrypts provider admin keys at rest
# generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=""

# Optional tuning
LEADERBOARD_WINDOW_DAYS=30
USAGE_BACKFILL_DAYS=30
